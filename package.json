{
  "name": "review-simple",
  "version": "1.6.0",
  "description": "Obsidian periodic review plugin",
  "license": "MIT",
  "main": "main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "dev:reload": "node esbuild.config.mjs --watch-reload",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "build:reload": "npm run build && node esbuild.config.mjs --reload-only",
    "check": "npm test && npm run build && npm run lint:obsidian && npm run lint:css",
    "lint:css": "stylelint styles.css --max-warnings 0",
    "lint:obsidian": "eslint src/ tests/",
    "test": "tsc --noEmit --skipLibCheck --project tsconfig.test.json && vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@typescript-eslint/parser": "^8.70.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "latest",
    "stylelint": "^17.15.0",
    "stylelint-config-obsidianmd": "^0.1.0",
    "tslib": "2.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
